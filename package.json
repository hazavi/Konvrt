{
  "name": "konvrt",
  "version": "1.1.0",
  "description": "Convert, compress, and download video, audio, images, and PDFs. Everything runs on your computer.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node electron/dev.cjs",
    "dev:astro": "astro dev",
    "build:astro": "astro build",
    "dev:electron": "electron .",
    "dev": "concurrently -k \"npm:dev:astro\" \"npm:dev:electron\"",
    "build": "npm run build:astro && npm run build:electron",
    "build:electron": "electron-builder --win --publish never",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test test/*.test.cjs",
    "build:all": "npm run build:astro && electron-builder --win --mac --linux --publish never"
  },
  "build": {
    "appId": "com.konvrt.app",
    "productName": "Konvrt",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/dev.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico",
      "artifactName": "Konvrt-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/favicon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/favicon.ico"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "hazavi",
        "repo": "Konvrt",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "mupdf": "^1.28.6",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "wait-on": "^9.5.1",
    "astro": "^7.4.11",
    "lucide": "^1.72.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0"
  },
  "allowScripts": {
    "electron@45.3.1": true,
    "ffmpeg-static@5.3.0": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hazavi/Konvrt.git"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
