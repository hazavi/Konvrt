---
import Icon from "./Icon.astro";
import "../styles/components/tools-panel.css";

type Category = { id: string; label: string; kind?: string };

const all: Category = { id: "all", label: "All" };
const video: Category = { id: "video", label: "Video", kind: "video" };
const audio: Category = { id: "audio", label: "Audio", kind: "audio" };
const image: Category = { id: "image", label: "Image", kind: "image" };
const gif: Category = { id: "gif", label: "GIF", kind: "gif" };
const pdf: Category = { id: "pdf", label: "PDF", kind: "pdf" };
const doc: Category = { id: "doc", label: "Document", kind: "doc" };

const sections = [
  {
    id: "convert",
    tab: "Convert Tools",
    desc: "Convert your media files to any format.",
    categories: [all, video, audio, image, gif, pdf, doc],
  },
  {
    id: "compress",
    tab: "Compress Tools",
    desc: "Reduce file sizes while preserving quality.",
    categories: [all, video, audio, image, gif],
  },
] as const;
---

<div id="tools-panel" style="display:none;">
  <div class="tools-header">
    <div class="segmented">
      {
        sections.map((s, i) => (
          <button
            class:list={["segmented-item", "tools-tab", { active: i === 0 }]}
            data-tools-view={s.id}
          >
            <Icon name={s.id} size={14} />
            {s.tab}
          </button>
        ))
      }
    </div>
  </div>

  {
    sections.map((s, i) => (
      <div id={`tools-${s.id}`} class="tools-section" style={i === 0 ? undefined : "display:none;"}>
        <div class="section-top">
          <p class="section-desc">{s.desc}</p>
          <div class="segmented segmented-sm segmented-neutral tools-categories" data-section={s.id}>
            {s.categories.map((cat) => (
              <button
                class:list={["segmented-item", "cat-tab", { active: cat.id === "all" }]}
                data-cat={cat.id}
              >
                {cat.kind && <span class="cat-dot" data-kind={cat.kind} />}
                {cat.label}
              </button>
            ))}
          </div>
        </div>
        <div class="tools-grid" id={`tools-${s.id}-grid`}></div>
      </div>
    ))
  }
</div>
