---
import Icon from "./Icon.astro";
import "../styles/components/dropzone.css";

const formats = [
  { kind: "video", labels: ["MP4", "MKV", "MOV", "WEBM", "AVI", "TS"] },
  { kind: "audio", labels: ["MP3", "WAV", "FLAC", "M4A", "OPUS"] },
  { kind: "image", labels: ["JPG", "PNG", "WEBP", "AVIF", "GIF", "HEIC"] },
  { kind: "pdf", labels: ["PDF"] },
  { kind: "doc", labels: ["HTML", "MD", "TXT", "CSV", "JSON"] },
] as const;
---

<div id="dropzone">
  <input id="browser-file-input" type="file" multiple hidden />
  <div id="empty-state">
    <div class="drop-ring">
      <div class="drop-ring-inner">
        <Icon name="upload" size={32} stroke={1.5} />
      </div>
    </div>
    <h2 class="drop-title">Drop your files here</h2>
    <p class="drop-subtitle">
      or browse to select videos, audio, images, or PDFs
    </p>
    <button id="browse-btn" class="btn btn-outline browse-btn">
      <Icon name="browse" size={14} />
      Browse Files
    </button>
    <div class="format-tags">
      {
        formats.flatMap(({ kind, labels }) =>
          labels.map((label) => (
            <span class="badge" data-kind={kind}>
              {label}
            </span>
          )),
        )
      }
      <span class="badge">+50 more</span>
    </div>
  </div>
</div>
