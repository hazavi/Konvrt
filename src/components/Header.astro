---
import Icon from "./Icon.astro";
import pkg from "../../package.json";
import "../styles/components/header.css";

const logo = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.ico`;

const tabs = [
  { id: "convert", label: "Convert" },
  { id: "compress", label: "Compress" },
  { id: "download", label: "Download" },
  { id: "tools", label: "Tools" },
] as const;
---

<header class="app-header">
  <div class="header-left">
    <div class="brand">
      <img class="logo" src={logo} alt="Konvrt" width="32" height="32" />
      <span class="brand-text">Konvrt</span>
    </div>
    <nav class="segmented" id="nav-tabs">
      {
        tabs.map((tab, i) => (
          <button
            class:list={["segmented-item", "tab", { active: i === 0 }]}
            data-tab={tab.id}
          >
            <Icon name={tab.id} size={15} />
            {tab.label}
          </button>
        ))
      }
    </nav>
  </div>
  <div class="header-right">
    <span class="badge badge-outline">v{pkg.version}</span>
    <div class="window-controls" id="window-controls" hidden>
      <button class="btn btn-icon btn-sm win-btn" id="win-min" aria-label="Minimize">
        <Icon name="minimize" size={14} stroke={3} />
      </button>
      <button class="btn btn-icon btn-sm win-btn" id="win-max" aria-label="Maximize">
        <Icon name="maximize" size={13} stroke={3} class="ico-max" />
        <Icon name="restore" size={14} stroke={3} class="ico-restore" />
      </button>
      <button class="btn btn-icon btn-sm win-btn win-close" id="win-close" aria-label="Close">
        <Icon name="close" size={14} stroke={3} />
      </button>
    </div>
  </div>
</header>
