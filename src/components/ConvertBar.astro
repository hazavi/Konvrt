---
import Icon from "./Icon.astro";
import "../styles/components/convert-bar.css";

const qualityGuide = [
  { tone: "success", range: "90-100%", text: "Best quality, larger file" },
  { tone: "primary", range: "70-89%", text: "Recommended balance" },
  { tone: "warning", range: "40-69%", text: "Smaller file, some loss" },
  { tone: "destructive", range: "1-39%", text: "Smallest file, noticeable loss" },
] as const;
---

<div id="convert-bar" class="hidden">
  <div class="bar-inner">
    <div class="bar-left">
      <span id="stats-label" class="stats">0 files</span>
      <div class="bar-divider"></div>
      <button
        id="output-dir-btn"
        class="btn btn-outline btn-sm bar-chip"
        title="Select output folder"
      >
        <Icon name="folder" size={13} />
        <span id="output-dir-label" class="truncate">Choose folder…</span>
      </button>
    </div>

    <div class="bar-center">
      <div class="bar-field" id="format-field">
        <div class="segmented segmented-xs format-tabs" id="format-tabs">
          <button class="segmented-item format-tab active" data-format-tab="video">Video</button>
          <button class="segmented-item format-tab" data-format-tab="audio">Audio</button>
        </div>
        <select id="format-select" class="input input-sm field-select">
          <option value="">—</option>
        </select>
      </div>

      <div class="bar-field quality-field">
        <label class="field-label">
          Quality <span id="quality-value" class="quality-val">80%</span>
        </label>
        <div class="slider-wrap">
          <input
            id="quality-slider"
            type="range"
            min="1"
            max="100"
            value="80"
            class="field-range"
          />
          <div class="progress slider-track">
            <div class="progress-fill" id="slider-fill" style="width:80%"></div>
          </div>
        </div>
        <button
          class="btn btn-outline btn-icon btn-round quality-help"
          id="quality-help"
          title="Quality guide"
        >
          <Icon name="help" size={12} />
        </button>
        <div class="quality-tooltip" id="quality-tooltip">
          <div class="tooltip-arrow"></div>
          <div class="tooltip-title">Quality Guide</div>
          {
            qualityGuide.map(({ tone, range, text }) => (
              <div class="tooltip-row">
                <span class="badge" data-tone={tone}>
                  {range}
                </span>
                {text}
              </div>
            ))
          }
        </div>
      </div>

      <div class="bar-field" id="mode-field">
        <label class="field-label">Mode</label>
        <div class="segmented segmented-sm" id="mode-toggle">
          <button class="segmented-item mode-btn active" data-mode="convert">Convert</button>
          <button class="segmented-item mode-btn" data-mode="compress">Compress</button>
        </div>
      </div>
    </div>

    <div class="bar-right">
      <button
        id="clear-btn"
        class="btn btn-outline btn-danger btn-sm"
        style="display:none;"
      >
        Clear
      </button>
      <button id="convert-btn" class="btn btn-primary btn-lg" disabled>
        <Icon name="convert" size={14} stroke={2.5} />
        Convert All
      </button>
    </div>
  </div>

  <div id="overall-progress" class="overall-progress" style="display:none;">
    <div class="progress">
      <div id="overall-fill" class="progress-fill" style="width:0%"></div>
    </div>
    <span id="overall-text" class="overall-text">0%</span>
  </div>
</div>
