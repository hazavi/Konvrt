---
import Icon from "./Icon.astro";
import "../styles/components/download-view.css";

const platforms = [
  { id: "youtube", label: "YouTube" },
  { id: "tiktok", label: "TikTok" },
] as const;

const formats = [
  { id: "mp4", icon: "video" },
  { id: "webm", icon: "video" },
  { id: "mp3", icon: "music" },
  { id: "m4a", icon: "music" },
  { id: "wav", icon: "music" },
] as const;

const qualities = [
  { id: "best", label: "Best" },
  { id: "1080", label: "1080p" },
  { id: "720", label: "720p" },
  { id: "480", label: "480p" },
] as const;
---

<div id="view-download" style="display:none;">
  <div class="dl-container">
    <!-- Setup banner (shown when yt-dlp is not installed) -->
    <div id="dl-setup" class="dl-setup" style="display:none;">
      <div class="dl-setup-icon">
        <Icon name="download" size={40} stroke={1.5} />
      </div>
      <h3 class="dl-setup-title">Download Engine Required</h3>
      <p class="dl-setup-desc">
        yt-dlp is needed to enable video downloading from YouTube and other
        platforms.
      </p>
      <button id="dl-install-btn" class="btn btn-primary btn-lg">
        <Icon name="download" size={14} />
        Install yt-dlp
      </button>
      <p id="dl-install-status" class="dl-setup-status"></p>
    </div>

    <div id="dl-main" style="display:none;">
      <div class="dl-input-section">
        <div class="segmented dl-platform-tabs" id="dl-platform-tabs">
          {
            platforms.map((p, i) => (
              <button
                class:list={["segmented-item", "dl-platform-tab", { active: i === 0 }]}
                data-platform={p.id}
              >
                <Icon name={p.id} size={14} />
                {p.label}
              </button>
            ))
          }
        </div>
        <div class="dl-url-row">
          <input
            id="dl-url-input"
            type="text"
            class="input dl-url-input"
            placeholder="Paste YouTube URL here..."
            autocomplete="off"
            spellcheck="false"
          />
          <button
            id="dl-fetch-btn"
            class="btn btn-primary btn-icon dl-fetch-btn"
            title="Fetch video info"
          >
            <Icon name="download" size={16} stroke={2.5} />
            <span class="spinner"></span>
          </button>
        </div>
      </div>

      <!-- Video info (shown after fetch) -->
      <div id="dl-info-card" class="card dl-info-card" style="display:none;">
        <div class="dl-thumb-wrap">
          <img id="dl-thumb" class="dl-thumb" src="" alt="" />
          <span id="dl-duration" class="dl-duration">0:00</span>
        </div>
        <div class="dl-info-details">
          <h3 id="dl-title" class="dl-info-title">Video Title</h3>
          <span id="dl-uploader" class="dl-info-uploader">Uploader</span>
          <span id="dl-platform-badge" class="badge dl-platform-badge" data-tone="primary">
            YouTube
          </span>
        </div>
      </div>

      <div id="dl-options" class="card dl-options" style="display:none;">
        <div class="dl-format-section">
          <label class="dl-label">Format</label>
          <div class="dl-format-btns" id="dl-format-btns">
            {
              formats.map((f, i) => (
                <button
                  class:list={["btn", "btn-outline", "dl-fmt-btn", { active: i === 0 }]}
                  data-dl-format={f.id}
                >
                  <Icon name={f.icon} size={14} />
                  {f.id.toUpperCase()}
                </button>
              ))
            }
          </div>
        </div>
        <div class="dl-quality-section">
          <label class="dl-label">Quality</label>
          <div class="dl-quality-btns" id="dl-quality-btns">
            {
              qualities.map((q, i) => (
                <button
                  class:list={["btn", "btn-outline", "dl-qual-btn", { active: i === 0 }]}
                  data-dl-quality={q.id}
                >
                  {q.label}
                </button>
              ))
            }
          </div>
        </div>
        <div class="dl-output-section">
          <button
            id="dl-output-btn"
            class="btn btn-outline btn-sm dl-output-chip"
            title="Select output folder"
          >
            <Icon name="folder" size={13} />
            <span id="dl-output-label" class="truncate">Choose folder...</span>
          </button>
          <div class="dl-proxy-row">
            <button
              id="dl-proxy-toggle"
              class="btn btn-outline btn-icon btn-sm dl-proxy-toggle"
              title="Proxy settings"
            >
              <Icon name="globe" size={13} />
            </button>
            <div id="dl-proxy-panel" class="dl-proxy-panel" style="display:none;">
              <input
                id="dl-proxy-input"
                class="input input-sm dl-proxy-input"
                type="text"
                placeholder="socks5://127.0.0.1:1080"
                spellcheck="false"
              />
              <button id="dl-proxy-save" class="btn btn-primary btn-sm">Save</button>
            </div>
          </div>
        </div>
        <button id="dl-start-btn" class="btn btn-primary btn-lg btn-block" disabled>
          <Icon name="download" size={16} stroke={2.5} />
          Download
        </button>
      </div>

      <div id="dl-progress" class="card dl-progress" style="display:none;">
        <div class="dl-progress-header">
          <span id="dl-progress-label" class="dl-progress-label">Downloading...</span>
          <span id="dl-progress-pct" class="dl-progress-pct">0%</span>
        </div>
        <div class="progress">
          <div id="dl-progress-fill" class="progress-fill" style="width:0%"></div>
        </div>
        <div class="dl-progress-meta">
          <span id="dl-progress-speed"></span>
          <span id="dl-progress-eta"></span>
        </div>
      </div>

      <div id="dl-actions-row" class="dl-actions-row" style="display:none;">
        <button
          id="dl-clear-btn"
          class="btn btn-outline btn-block"
          title="Clear and start fresh"
        >
          <Icon name="refresh" size={14} />
          New Download
        </button>
      </div>
    </div>
  </div>
</div>
